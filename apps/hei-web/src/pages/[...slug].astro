---
import { getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import HeiBlocks from "../components/HeiBlocks.astro";

export const prerender = false;

const slug = Astro.params.slug || "home";

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) {
	return Astro.redirect("/404");
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const content = page?.data.content;
---

<Base title={page?.data.title ?? ""}>
	{
		content ? (
			<HeiBlocks value={content} />
		) : (
			<p class="container section">Contenido pendiente.</p>
		)
	}
</Base>
