---
import { getMenu, getSiteSettings } from "emdash";
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import Logo from "../components/Logo.astro";
import "../styles/theme.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title || "Grupo HEI";
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription =
	settings?.tagline ||
	"El respaldo que conecta marcas de salud. Grupo HEI integra distribución, logística, software y servicio para el sector salud en Guatemala.";

const [menu, footerCompany] = await Promise.all([
	getMenu("primary"),
	getMenu("footer_company"),
]);

const currentPath = Astro.url.pathname;
const isActive = (url: string) =>
	url === "/" ? currentPath === "/" : currentPath.startsWith(url);

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: description || siteDescription,
	canonical: Astro.url.href,
	image,
	seo: { ogImage: image },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-sans" preload />
	</head>
	<body>
		<header class="site-header">
			<nav class="nav container">
				<a href="/" class="site-logo" aria-label={siteTitle}>
					<Logo variant="light" />
				</a>

				<button
					class="nav-toggle"
					aria-label="Abrir menú"
					aria-expanded="false"
					data-nav-toggle
				>
					<span></span><span></span><span></span>
				</button>

				<div class="nav-menu" data-nav-menu>
					<div class="nav-links">
						{
							menu?.items.map((item) => (
								<a
									href={item.url}
									target={item.target}
									class:list={["nav-link", { active: isActive(item.url) }]}
								>
									{item.label}
								</a>
							))
						}
					</div>
					<a href="/contacto" class="btn btn-primary nav-cta">¡Hablemos!</a>
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-content container">
				<div class="footer-brand">
					<Logo />
					<p class="footer-tagline">
						{settings?.tagline ||
							"Una base construida desde 1968 para conectar y respaldar marcas de salud en Guatemala."}
					</p>
				</div>

				<div class="footer-col">
					<h4>Contáctanos</h4>
					<p>Ciudad de Guatemala</p>
					<p>Calle 00 — 0000-00</p>
					<p><a href="tel:+50200000000">(+502) 0000 0000</a></p>
					<p><a href="mailto:contacto@grupohei.com">contacto@grupohei.com</a></p>
					<p><a href="/contacto">Contáctenos</a></p>
				</div>

				<div class="footer-col">
					<h4>Sobre Grupo HEI</h4>
					{
						footerCompany?.items.map((item) => (
							<a href={item.url} target={item.target}>
								{item.label}
							</a>
						))
					}
				</div>

				<div class="footer-meta">
					<p>&copy; {new Date().getFullYear()} Grupo HEI</p>
					<p>Todos los derechos reservados.</p>
				</div>
			</div>
		</footer>

		<script>
			const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
			const menu = document.querySelector<HTMLElement>("[data-nav-menu]");
			toggle?.addEventListener("click", () => {
				const open = document.body.classList.toggle("nav-open");
				toggle.setAttribute("aria-expanded", String(open));
				toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
			});
			menu?.querySelectorAll("a").forEach((a) =>
				a.addEventListener("click", () => {
					document.body.classList.remove("nav-open");
					toggle?.setAttribute("aria-expanded", "false");
				})
			);
		</script>

		<style is:global>
			@layer base;

			@layer base {
				*,
				*::before,
				*::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				:root {
					--color-bg: #ffffff;
					--color-text: #0e1b2a;
					--color-muted: #5c6b7a;
					--color-border: #e6ebf0;
					--color-surface: #f4f7f9;
					--color-primary: #31d697;
					--color-primary-dark: #20bd82;
					--color-primary-light: #7fe8c5;
					--color-accent: #2563eb;

					--font-mono: ui-monospace, "SF Mono", monospace;
					--font-size-xs: 0.75rem;
					--font-size-sm: 0.875rem;
					--font-size-base: 1rem;
					--font-size-lg: 1.125rem;
					--font-size-xl: 1.25rem;
					--font-size-2xl: 1.5rem;
					--font-size-3xl: 2rem;
					--font-size-4xl: 2.5rem;
					--font-size-5xl: 3.5rem;
					--font-size-6xl: 4.5rem;

					--spacing-xs: 0.25rem;
					--spacing-sm: 0.5rem;
					--spacing-md: 1rem;
					--spacing-lg: 1.5rem;
					--spacing-xl: 2rem;
					--spacing-2xl: 3rem;
					--spacing-3xl: 4rem;
					--spacing-4xl: 6rem;
					--spacing-5xl: 8rem;

					--max-width: 720px;
					--wide-width: 1200px;
					--radius-sm: 6px;
					--radius: 10px;
					--radius-lg: 16px;
					--radius-full: 9999px;

					--transition-fast: 150ms ease;
					--transition-base: 200ms ease;
					--transition-slow: 300ms ease;

					--shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
					--shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
					--shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
					--shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-sans);
					font-size: var(--font-size-base);
					line-height: 1.6;
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					min-height: 100vh;
				}

				a {
					color: currentColor;
					text-decoration: none;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-weight: 800;
					line-height: 1.15;
					letter-spacing: -0.02em;
				}

				h1 {
					font-size: var(--font-size-5xl);
				}
				h2 {
					font-size: var(--font-size-3xl);
				}
				h3 {
					font-size: var(--font-size-2xl);
				}
				h4 {
					font-size: var(--font-size-xl);
				}

				.container {
					max-width: var(--wide-width);
					margin: 0 auto;
					padding: 0 var(--spacing-lg);
				}

				.section {
					padding: var(--spacing-4xl) 0;
				}

				.btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					gap: var(--spacing-sm);
					padding: var(--spacing-sm) var(--spacing-xl);
					font-family: inherit;
					font-size: var(--font-size-sm);
					font-weight: 600;
					border-radius: var(--radius-full);
					cursor: pointer;
					transition:
						background var(--transition-fast),
						transform var(--transition-fast),
						box-shadow var(--transition-fast);
				}

				.btn:hover {
					transform: translateY(-1px);
				}
				.btn:active {
					transform: translateY(0);
				}

				.btn-lg {
					padding: var(--spacing-md) var(--spacing-xl);
					font-size: var(--font-size-base);
				}
			}
		</style>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				background: rgba(14, 27, 42, 0.55);
				backdrop-filter: blur(12px);
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
			}

			.nav {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: var(--spacing-lg);
				padding-top: var(--spacing-md);
				padding-bottom: var(--spacing-md);
			}

			.nav-menu {
				display: flex;
				align-items: center;
				gap: var(--spacing-xl);
			}

			.nav-links {
				display: flex;
				flex-wrap: wrap;
				gap: var(--spacing-lg);
			}

			.nav-link {
				position: relative;
				font-size: var(--font-size-sm);
				font-weight: 500;
				color: rgba(255, 255, 255, 0.82);
				transition: color var(--transition-fast);
			}

			.nav-link:hover,
			.nav-link.active {
				color: #fff;
			}

			/* Subrayado verde bajo el item activo. */
			.nav-link.active::after {
				content: "";
				position: absolute;
				left: 0;
				right: 0;
				bottom: -6px;
				height: 2px;
				border-radius: 2px;
				background: var(--color-primary);
			}

			.nav-cta {
				white-space: nowrap;
				text-transform: uppercase;
				letter-spacing: 0.03em;
			}

			.nav-toggle {
				display: none;
				flex-direction: column;
				gap: 5px;
				background: none;
				border: none;
				cursor: pointer;
				padding: 6px;
			}

			.nav-toggle span {
				width: 24px;
				height: 2px;
				background: #fff;
				border-radius: 2px;
				transition: transform var(--transition-fast);
			}

			main {
				min-height: calc(100vh - 240px);
			}

			/* --- Footer --- */
			.site-footer {
				position: relative;
				z-index: 2;
				background: #fff;
				border-radius: 32px 32px 0 0;
				margin-top: -32px;
			}

			.footer-content {
				display: grid;
				grid-template-columns: 1.6fr 1fr 1fr 1fr;
				gap: var(--spacing-2xl);
				padding-top: var(--spacing-4xl);
				padding-bottom: var(--spacing-2xl);
			}

			.footer-tagline {
				margin-top: var(--spacing-md);
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				max-width: 30ch;
			}

			.footer-col h4 {
				font-size: var(--font-size-sm);
				font-weight: 700;
				color: var(--color-primary);
				margin-bottom: var(--spacing-md);
			}

			.footer-col p,
			.footer-col a {
				display: block;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				padding: var(--spacing-xs) 0;
				transition: color var(--transition-fast);
			}

			.footer-col a:hover {
				color: var(--color-navy);
			}

			.footer-meta {
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				text-align: right;
			}

			@media (max-width: 900px) {
				.footer-content {
					grid-template-columns: 1fr 1fr;
				}
				.footer-meta {
					text-align: left;
				}
			}

			@media (max-width: 768px) {
				.nav-toggle {
					display: flex;
				}

				.nav-menu {
					position: fixed;
					inset: 64px 0 auto 0;
					flex-direction: column;
					align-items: stretch;
					gap: var(--spacing-md);
					background: #fff;
					padding: var(--spacing-lg);
					border-bottom: 1px solid var(--color-border);
					box-shadow: var(--shadow-lg);
					transform: translateY(-120%);
					transition: transform var(--transition-base);
				}

				:global(body.nav-open) .nav-menu {
					transform: translateY(0);
				}

				.nav-links {
					flex-direction: column;
					gap: var(--spacing-md);
				}

				/* En móvil el menú desplegable es blanco: enlaces en navy. */
				.nav-link {
					color: var(--color-navy);
				}

				.nav-cta {
					align-self: flex-start;
				}

				h1 {
					font-size: var(--font-size-4xl);
				}
			}

			@media (max-width: 560px) {
				.footer-content {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
