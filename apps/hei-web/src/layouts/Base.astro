---
import { getMenu, getSiteSettings } from "emdash";
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "../styles/theme.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const settings = await getSiteSettings();
const brandColor = settings?.brandColor || "#31d697";
const hex = brandColor.replace("#", "");
const r = parseInt(hex.substring(0, 2), 16);
const g = parseInt(hex.substring(2, 4), 16);
const b = parseInt(hex.substring(4, 6), 16);
const brandColorRgb = isNaN(r) || isNaN(g) || isNaN(b) ? "49, 214, 151" : `${r}, ${g}, ${b}`;
const siteTitle = settings?.title || "Grupo HEI";
const fullTitle = title ? `${title} - ${siteTitle}` : siteTitle;
const siteDescription =
	settings?.tagline ||
	"El respaldo que conecta marcas de salud. Grupo HEI integra distribucion, logistica, software y servicio para el sector salud en Guatemala.";

const [menu, footerCompany] = await Promise.all([
	getMenu("primary"),
	getMenu("footer_company"),
]);

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const parentMap: Record<string, string> = {
	"/salutia": "/marcas",
	"/cendis": "/marcas",
	"/meliora": "/marcas",
};
const effectivePath = parentMap[currentPath] ?? currentPath;
const isActive = (url: string) => {
	const cleanUrl = url.replace(/\/$/, "") || "/";
	return cleanUrl === "/" ? effectivePath === "/" : effectivePath.startsWith(cleanUrl);
};
const darkNav = ["/salutia", "/cendis", "/meliora"].includes(currentPath);

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: description || siteDescription,
	canonical: Astro.url.href,
	image,
	seo: { ogImage: image },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="es" style={`--brand-color: ${brandColor}; --brand-color-rgb: ${brandColorRgb}`}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Work+Sans:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class:list={["nav", { "nav--dark": darkNav }]}>
			<div class="nav__inner">
				<a href="/" class="nav__logo" aria-label={siteTitle}>
					<img src="/wp/logos/logo-hei-principal-blanco.png" alt={siteTitle} />
				</a>

				<nav class="nav__links" aria-label="Menu principal">
					{
						menu?.items.map((item) => (
							<a
								href={item.url}
								target={item.target}
								class:list={{ active: isActive(item.url) }}
							>
								{item.label}
							</a>
						))
					}
				</nav>

				<a href="/contacto" class="btn btn-primary nav__cta">¡Hablemos!</a>

				<button
					class="nav__hamburger"
					aria-label="Abrir menu"
					aria-expanded="false"
					data-nav-toggle
				>
					&#9776;
				</button>
			</div>

			<nav class="nav__mobile-menu" aria-label="Menu mobile" data-nav-menu>
				{
					menu?.items.map((item) => (
						<a
							href={item.url}
							target={item.target}
							class:list={{ active: isActive(item.url) }}
						>
							{item.label}
						</a>
					))
				}
				<a href="/contacto" class="btn btn-primary">¡Hablemos!</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="footer">
			<div class="container">
				<div class="footer__grid">
					<div class="footer__brand">
						<img src="/wp/logos/logo-hei-principal.png" alt={siteTitle} />
						<p>
							{settings?.tagline ||
								"Una base construida desde 1968 para conectar y respaldar marcas de salud en Guatemala."}
						</p>
					</div>

					<div class="footer__col">
						<h4>Contáctenos</h4>
						<p>
							Ciudad de Guatemala<br />
							(+502) 0000 0000<br />
							<a href="mailto:contacto@grupohei.com">contacto@grupohei.com</a>
						</p>
						<a href="/contacto">Contáctenos</a>
					</div>

					<div class="footer__col">
						<h4>Sobre Grupo HEI</h4>
						{
							footerCompany?.items.map((item) => (
								<a href={item.url} target={item.target}>
									{item.label}
								</a>
							))
						}
					</div>

					<div class="footer__col derechos-reservados">
						<p>© {new Date().getFullYear()} Grupo HEI. Todos los derechos reservados.</p>
					</div>
				</div>
			</div>
		</footer>

		<script>
			const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
			const menu = document.querySelector<HTMLElement>("[data-nav-menu]");
			toggle?.addEventListener("click", () => {
				const open = !menu?.classList.contains("open");
				menu?.classList.toggle("open", open);
				toggle.setAttribute("aria-expanded", String(open));
				toggle.setAttribute("aria-label", open ? "Cerrar menu" : "Abrir menu");
			});
			menu?.querySelectorAll("a").forEach((a) =>
				a.addEventListener("click", () => {
					menu.classList.remove("open");
					toggle?.setAttribute("aria-expanded", "false");
				})
			);
		</script>
	</body>
</html>
