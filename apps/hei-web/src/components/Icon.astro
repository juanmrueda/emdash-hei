	lightning: '<path d="M13 2L5 13h6l-1 9 8-12h-6l1-8z"/>',
	plant:
		'<path d="M12 21v-8"/><path d="M12 13c0-3 2-5.5 6.5-5.5 0 3.2-2.2 5.5-6.5 5.5z"/><path d="M12 14.5c0-2.6-2-4.8-5.5-4.8 0 2.7 2 4.8 5.5 4.8z"/>',
