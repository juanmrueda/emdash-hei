		'<path d="M5 19c0-8 6-13 14-13 0 8-6 13-14 13z"/><path d="M5.5 18.5c3-5 6-7.5 10-9.5"/>',
	sparkle:
		'<path d="M12 3l1.8 6.2L20 11l-6.2 1.8L12 19l-1.8-6.2L4 11l6.2-1.8L12 3z"/>',
	chat: '<path d="M4 5h16v11H9l-5 4z"/>',
	phone:
