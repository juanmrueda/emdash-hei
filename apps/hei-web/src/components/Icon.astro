---
/**
 * Self-contained inline-SVG icon set for Grupo HEI.
 *
 * Replaces astro-iconset to avoid the Vite dep-optimizer breaking SSR under
 * the Cloudflare/workerd dev runner. Icons are simple 24×24 line glyphs that
 * inherit `currentColor`. Add new glyphs to ICONS as needed.
 */
interface Props {
	name: string;
	size?: number;
}

const { name, size = 24 } = Astro.props;

const ICONS: Record<string, string> = {
	check: '<path d="M5 12.5l4.5 4.5L19 7"/>',
	"check-circle":
		'<circle cx="12" cy="12" r="9"/><path d="M8 12.2l2.8 2.8L16 9"/>',
	globe:
		'<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 2.6 15.4 0 18M12 3c-2.6 2.6-2.6 15.4 0 18"/>',
	stack: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 12l9 5 9-5"/>',
	users:
		'<circle cx="9" cy="9" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><path d="M15.5 6.4a3 3 0 0 1 0 5.2M20.5 19a5 5 0 0 0-3.8-4.8"/>',
	"seal-check":
		'<path d="M12 2.6l2.5 1.7 3-.1 .9 2.9 2.5 1.7-1 2.9 1 2.9-2.5 1.7-.9 2.9-3-.1L12 21.4l-2.5-1.7-3 .1-.9-2.9L3.1 15.2l1-2.9-1-2.9 2.5-1.7 .9-2.9 3 .1z"/><path d="M8.6 12l2.4 2.4 4.4-4.6"/>',
