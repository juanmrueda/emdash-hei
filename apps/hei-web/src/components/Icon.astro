	"hand-heart":
		'<path d="M20.8 9.1a4.7 4.7 0 0 0-8.8-1.4A4.7 4.7 0 0 0 3.2 9.1c0 4.2 4.6 7.2 8.8 10.7 4.2-3.5 8.8-6.5 8.8-10.7z"/>',
