	bulb:
		'<path d="M9.5 18h5M10 21h4"/><path d="M12 3a6 6 0 0 0-3.8 10.6c.8.7 1.3 1.3 1.3 2.4h5c0-1.1.5-1.7 1.3-2.4A6 6 0 0 0 12 3z"/>',
