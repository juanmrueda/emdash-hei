---
import Icon from "../Icon.astro";

interface Props {
	node: {
		_key?: string;
		layout?: "band" | "card";
		heroCard?: boolean;
		photoStyle?: boolean;
		icon?: string;
		iconImage?: string;
		eyebrow?: string;
		heading: string;
		body?: string;
		image?: string;
		imageAlt?: string;
		primaryCtaLabel?: string;
		primaryCtaUrl?: string;
		secondaryCtaLabel?: string;
		secondaryCtaUrl?: string;
		whatsapp?: boolean;
		focal?: string;
	};
}

const { node } = Astro.props;
const layout = node.layout ?? "band";
const hasPrimary = node.primaryCtaLabel && node.primaryCtaUrl;
const hasSecondary = node.secondaryCtaLabel && node.secondaryCtaUrl;
const showBandCta = hasPrimary && !node.photoStyle;
const bgStyle = node.image
	? `background-image:url('${node.image}');${node.focal ? `background-position:${node.focal};` : ""}`
	: undefined;
const bodyLines = (node.body ?? "")
	.split("\n")
	.map((line) => line.trim())
	.filter(Boolean);
const isHomeSplit = node._key?.startsWith("home-") || node._key === "so-cta";
const isHomeBanner = !!node.iconImage;

function splitLabel(line: string) {
	const match = line.match(/^([^:]{1,28}):\s*(.+)$/);
	return match ? { label: match[1], text: match[2] } : { label: "", text: line };
}
---

{
	node.heroCard ? (
		<section class="salutia-heroint">
			<div>
				<div class="salutia-hero__body">
					<h1>{node.heading}</h1>
					{node.body && <p>{node.body}</p>}
					<div class="split__btns">
						{hasPrimary && <a href={node.primaryCtaUrl} class="btn btn-white">{node.primaryCtaLabel}</a>}
						{hasSecondary && <a href={node.secondaryCtaUrl} class="btn btn-outline-white">{node.secondaryCtaLabel}</a>}
					</div>
				</div>
				{node.image && <div class="salutia-hero__img" style={bgStyle}></div>}
			</div>
		</section>
	) : layout === "card" ? (
		<section class={isHomeSplit ? "splithome" : "splitinternas"}>
			<div>
				<div class="split__body split__body--green">
					<h2 class="text-white">{node.heading}</h2>
					{bodyLines.map((line) => {
						const item = splitLabel(line);
						return (
							<p class="text-white">
								{item.label && <strong>{item.label}: </strong>}
								{item.text}
							</p>
						);
					})}
					{(hasPrimary || hasSecondary) && (
						<div class="split__btns">
							{hasPrimary && (
								<a href={node.primaryCtaUrl} class={hasSecondary ? "btn btn-outline-white" : "btn btn-white"}>
									{node.primaryCtaLabel}
								</a>
							)}
							{hasSecondary && (
								<a href={node.secondaryCtaUrl} class="btn btn-white" target={node.whatsapp ? "_blank" : undefined} rel={node.whatsapp ? "noopener" : undefined}>
									{node.secondaryCtaLabel}
									{node.whatsapp && <span class="btn__icon" aria-hidden="true"><Icon name="whatsapp" size={20} /></span>}
								</a>
							)}
						</div>
					)}
				</div>
				{node.image && <div class="split__img" style={bgStyle}></div>}
			</div>
		</section>
	) : (
		<section class={isHomeBanner ? "sos-banner" : `cta-banner ${node.photoStyle ? "cta-banner--dark" : "cta-banner--centered"}`} style={bgStyle}>
			<div class={isHomeBanner ? "sos-banner__content" : "cta-banner__content"}>
				{!isHomeBanner && node.icon && <div class="cta-banner__icon"></div>}
				{isHomeBanner && <div class="sos-banner__icon">{node.iconImage && <img src={node.iconImage} alt="" style="width:100%;height:100%;object-fit:contain;border-radius:50%;" />}</div>}
				<h2>{node.heading}</h2>
				{node.body && <p>{node.body}</p>}
				{showBandCta && (
					<a href={node.primaryCtaUrl} class="btn btn-white" target={node.whatsapp ? "_blank" : undefined} rel={node.whatsapp ? "noopener" : undefined}>
						{node.primaryCtaLabel}
						{node.whatsapp && <span class="btn__icon" aria-hidden="true"><Icon name="whatsapp" size={20} /></span>}
					</a>
				)}
			</div>
		</section>
	)
}
