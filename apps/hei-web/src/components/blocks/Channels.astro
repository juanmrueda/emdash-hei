---
interface Channel {
	icon?: string;
	title: string;
	text: string;
}

interface Props {
	node: {
		eyebrow?: string;
		heading?: string;
		subheading?: string;
		image: string;
		imageAlt?: string;
		imagePosition?: "left" | "right";
		items: Channel[];
	};
}

const { node } = Astro.props;
const items = node.items ?? [];
---

<section class="intro-section">
	<div class="container">
		{node.heading && <h2>{node.heading}</h2>}
		<div class="section-header__line" style="margin:12px auto 20px;"></div>
		{node.subheading && <p>{node.subheading}</p>}
	</div>
</section>

<section class="section fondo-lineas" style="padding-top:0;">
	<div class="canales-wrap">
		<div class="canales-img">
			<img src={node.image} alt={node.imageAlt || ""} loading="lazy" />
		</div>
		<div class="timeline timeline--channels">
			{
				items.map((channel) => (
					<div class="timeline__item">
						<div class="timeline__bullet-col">
							<div class="timeline__bullet"></div>
							<div class="timeline__line"></div>
						</div>
						<div class="timeline__content">
							<h3>{channel.title}</h3>
							<p>{channel.text}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
