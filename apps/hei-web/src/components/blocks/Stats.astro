---
interface StatItem {
	value: string;
	label: string;
	icon?: string;
	img?: string;
}

interface Props {
	node: {
		variant?: "big" | "inline";
		items: StatItem[];
	};
}

const { node } = Astro.props;
const items = node.items ?? [];

function split(value: string) {
	const m = value.trim().match(/^([^\d]*)([\d,.]+)(.*)$/);
	return { prefix: m?.[1] ?? "", figure: m?.[2] ?? value, suffix: m?.[3] ?? "" };
}
---

<section class="section bg-white home">
	<div class="container">
		<div class="cards-grid">
			{
				items.map((item) => {
					const stat = split(item.value);
					return (
						<div class="card">
							{item.img && <img src={item.img} alt={item.label} class="card__icon" loading="lazy" />}
							<div class="card__num">
								<span class="card-num-prefix">{stat.prefix}</span>
								<span class="card-num-value">{stat.figure}</span>
								{stat.suffix && <span class="card-num-suffix">{stat.suffix}</span>}
							</div>
							<div class="card__label">{item.label}</div>
						</div>
					);
				})
			}
		</div>
	</div>
</section>
