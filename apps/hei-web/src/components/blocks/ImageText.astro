---
interface Props {
	node: {
		eyebrow?: string;
		heading: string;
		accent?: boolean;
		body?: string;
		bullets?: string[] | string;
		image: string;
		imageAlt?: string;
		imagePosition?: "left" | "right";
		badge?: string;
		stats?: { value: string; label: string }[];
		ctaLabel?: string;
		ctaUrl?: string;
	};
}

const { node } = Astro.props;
const bullets = Array.isArray(node.bullets)
	? node.bullets
	: typeof node.bullets === "string"
		? node.bullets.split("\n").map((s) => s.trim()).filter(Boolean)
		: [];
const stats = node.stats ?? [];
const hasCta = node.ctaLabel && node.ctaUrl;
const reverse = node.imagePosition === "right";

function splitStat(value: string) {
	const m = value.trim().match(/^([+]?)([\d,.]+)(.*)$/);
	return { prefix: m?.[1] ?? "", value: m?.[2] ?? value, suffix: m?.[3] ?? "" };
}
---

<section class:list={["about-split", "bg-white", { "about-split--reverse": reverse }]}>
	<div class="about-img">
		<img src={node.image} alt={node.imageAlt || node.heading} loading="lazy" />
		{
			node.badge && !stats.length && (
				<div class="about-img__stat">
					<div class="stat-card">
						<div class="stat-card__item">
							<span class="stat-card__num">{node.badge}</span>
						</div>
					</div>
				</div>
			)
		}
		{
			stats.length > 0 && (
				<div class="about-img__stat">
					<div class="stat-card">
						{stats.map((s, index) => {
							const stat = splitStat(s.value);
							return (
								<>
									{index > 0 && <div class="stat-card__divider"></div>}
									<div class="stat-card__item">
										<span class="stat-card__num">
											{stat.prefix}
											<span class="stat-num-value">{stat.value}</span>
											<span class="stat-sym">{stat.suffix}</span>
										</span>
										<span class="stat-card__label">{s.label}</span>
									</div>
								</>
							);
						})}
					</div>
				</div>
			)
		}
	</div>

	<div class="about-body">
		{node.eyebrow && <p class="eyebrow">{node.eyebrow}</p>}
		<h2 class:list={{ "text-green": node.accent }}>{node.heading}</h2>
		{node.body && <p>{node.body}</p>}
		{
			bullets.length > 0 && (
				<ul class="bullet-list">
					{bullets.map((bullet) => (
						<li>
							<span class="bullet-icon" aria-hidden="true">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M5 13L9 17L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</span>
							<span>{bullet}</span>
						</li>
					))}
				</ul>
			)
		}
		{hasCta && <a href={node.ctaUrl} class="btn btn-primary mt-24">{node.ctaLabel}</a>}
	</div>
</section>
