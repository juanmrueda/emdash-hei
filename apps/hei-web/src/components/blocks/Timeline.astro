---
interface Milestone {
	title: string;
	text: string;
}

interface Props {
	node: {
		eyebrow?: string;
		heading?: string;
		image: string;
		imageAlt?: string;
		badge?: string;
		items: Milestone[];
	};
}

const { node } = Astro.props;
const items = node.items ?? [];
---

<section class="section bg-white fondo-lineas">
	<div class="container">
		<div class="section-header">
			<h2>{node.heading || node.eyebrow}</h2>
			<div class="section-header__line"></div>
		</div>

		<div class="timeline-wrap">
			<div class="canales-img">
				{node.badge && <div class="annoflotante">{node.badge}</div>}
				<img src={node.image} alt={node.imageAlt || "Historia HEI"} style="border-radius:12px;" loading="lazy" />
			</div>
			<div class="timeline timeline--story">
				{
					items.map((item) => (
						<div class="timeline__item">
							<div class="timeline__bullet-col">
								<div class="timeline__bullet"></div>
								<div class="timeline__line"></div>
							</div>
							<div class="timeline__content">
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
