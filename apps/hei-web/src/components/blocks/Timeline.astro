---
/**
 * "Nuestra Historia" style block: an image with an optional year badge on
 * one side and a stack of titled milestones on the other.
 */
interface Milestone {
	title: string;
	text: string;
}
interface Props {
	node: {
		eyebrow?: string;
		heading?: string;
		image: string;
		imageAlt?: string;
		badge?: string;
		items: Milestone[];
	};
}

const { node } = Astro.props;
const items = node.items ?? [];
---

<section class="section">
	<div class="container">
		{
			(node.eyebrow || node.heading) && (
				<div class="section-heading">
					{node.eyebrow && <span class="eyebrow">{node.eyebrow}</span>}
					{node.heading && <h2>{node.heading}</h2>}
					<div class="heading-rule" />
				</div>
			)
		}

		<div class="tl-grid">
			<div class="tl-media">
				<div class="tl-blob" aria-hidden="true"></div>
				<img src={node.image} alt={node.imageAlt || ""} loading="lazy" />
				{node.badge && <span class="tl-badge">{node.badge}</span>}
			</div>

			<ol class="tl-items">
				{
					items.map((m) => (
						<li class="tl-item">
							<span class="tl-dot" aria-hidden="true" />
							<div>
								<h3>{m.title}</h3>
								<p>{m.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<style>
	.tl-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-4xl);
		align-items: center;
	}

	.tl-media {
		position: relative;
	}

	.tl-media img {
		width: 100%;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		position: relative;
		z-index: 1;
	}

	.tl-blob {
		position: absolute;
		width: 60%;
		height: 60%;
		right: -6%;
		bottom: -8%;
		background: var(--color-primary);
		opacity: 0.18;
		border-radius: 48% 52% 56% 44% / 52% 48% 52% 48%;
	}

	.tl-badge {
		position: absolute;
		z-index: 2;
		top: var(--spacing-lg);
		left: calc(-1 * var(--spacing-md));
		background: var(--color-primary);
		color: #fff;
		font-weight: 800;
		padding: var(--spacing-sm) var(--spacing-lg);
		border-radius: var(--radius-full);
		box-shadow: var(--shadow);
	}

	.tl-items {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xl);
	}

	.tl-item {
		display: flex;
		gap: var(--spacing-md);
		position: relative;
	}

	.tl-dot {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--color-primary);
		flex-shrink: 0;
		margin-top: 6px;
	}

	.tl-item h3 {
		font-size: var(--font-size-xl);
		margin-bottom: var(--spacing-xs);
	}

	.tl-item p {
		color: var(--color-muted);
	}

	@media (max-width: 860px) {
		.tl-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-2xl);
		}
	}
</style>
