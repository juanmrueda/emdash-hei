---
/**
 * "Nuestra Historia": imagen con insignia de año (círculo, arriba a la
 * derecha) y una lista de hitos con riel vertical. La sección lleva un fondo
 * de líneas diagonales sutiles.
 */
interface Milestone {
	title: string;
	text: string;
}
interface Props {
	node: {
		eyebrow?: string;
		heading?: string;
		image: string;
		imageAlt?: string;
		badge?: string;
		items: Milestone[];
	};
}

const { node } = Astro.props;
const items = node.items ?? [];
---

<section class="section tl-section">
	<div class="container">
		{
			(node.eyebrow || node.heading) && (
				<div class="section-heading">
					{node.eyebrow && <span class="eyebrow">{node.eyebrow}</span>}
					{node.heading && <h2>{node.heading}</h2>}
					<div class="heading-rule" />
				</div>
			)
		}

		<div class="tl-grid">
			<div class="tl-media">
				<img src={node.image} alt={node.imageAlt || ""} loading="lazy" />
				{node.badge && <span class="tl-badge">{node.badge}</span>}
			</div>

			<ol class="tl-items">
				{
					items.map((m) => (
						<li class="tl-item">
							<span class="tl-dot" aria-hidden="true" />
							<div>
								<h3>{m.title}</h3>
								<p>{m.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<style>
	/* Fondo de líneas diagonales sutiles. */
	.tl-section {
		background-color: #fff;
		background-image: repeating-linear-gradient(
			135deg,
			rgba(14, 27, 42, 0.035) 0,
			rgba(14, 27, 42, 0.035) 1px,
			transparent 1px,
			transparent 12px
		);
	}

	.tl-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-4xl);
		align-items: center;
	}

	.tl-media {
		position: relative;
	}

	.tl-media img {
		width: 100%;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		display: block;
	}

	/* Insignia de año: círculo verde, arriba a la derecha (sobresale). */
	.tl-badge {
		position: absolute;
		z-index: 2;
		top: calc(-1 * var(--spacing-lg));
		right: calc(-1 * var(--spacing-lg));
		width: 84px;
		height: 84px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-primary);
		color: #fff;
		font-weight: 800;
		font-size: var(--font-size-lg);
		box-shadow: var(--shadow);
	}

	/* Lista de hitos con riel vertical. */
	.tl-items {
		position: relative;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2xl);
	}

	.tl-items::before {
		content: "";
		position: absolute;
		left: 6px;
		top: 8px;
		bottom: 8px;
		width: 2px;
		background: var(--color-border);
	}

	.tl-item {
		display: flex;
		gap: var(--spacing-lg);
		position: relative;
	}

	.tl-dot {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--color-muted);
		border: 3px solid #fff;
		box-sizing: content-box;
		flex-shrink: 0;
		margin-top: 4px;
		margin-left: -3px;
		z-index: 1;
	}

	.tl-item h3 {
		font-size: var(--font-size-xl);
		color: var(--color-primary);
		margin-bottom: var(--spacing-xs);
	}

	.tl-item p {
		color: var(--color-muted);
	}

	@media (max-width: 860px) {
		.tl-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-3xl);
		}
	}
</style>
