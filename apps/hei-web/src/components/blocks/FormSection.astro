---
import { blockComponents } from "@emdash-cms/plugin-forms/astro";
import "@emdash-cms/plugin-forms/styles";

interface Props {
	node: {
		_key?: string;
		eyebrow?: string;
		heading?: string;
		body?: string;
		formId: string;
		image?: string;
		imageAlt?: string;
		imagePosition?: "left" | "right";
		surface?: boolean;
	};
}

const FormEmbed = blockComponents["emdash-form"];
const { node } = Astro.props;
const imageFirst = node.imagePosition === "left";
const innerClass = imageFirst ? "grid-2-1" : node._key === "s-form" ? "internamarcas" : "";
const imageStyle = node.image ? `background-image:url('${node.image}');` : undefined;
const sectionId = node._key === "s-form" ? "formulario-marca" : node._key;
---

<section class="form-splitint" id={sectionId}>
	<div class={innerClass}>
		{
			imageFirst && node.image && (
				<div class="form-split__img" style={imageStyle} aria-label={node.imageAlt || ""}></div>
			)
		}

		<div class="form-split__body">
			{node.heading && <h2>{node.heading}</h2>}
			{node.body && <p>{node.body}</p>}
			<div class="emdash-form-shell">
				<FormEmbed node={{ formId: node.formId }} />
			</div>
		</div>

		{
			!imageFirst && node.image && (
				<div class="form-split__img" style={imageStyle} aria-label={node.imageAlt || ""}></div>
			)
		}
	</div>
</section>
