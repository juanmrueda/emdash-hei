---
import { blockComponents } from "@emdash-cms/plugin-forms/astro";
import "@emdash-cms/plugin-forms/styles";

/**
 * Section that pairs a heading/intro with an embedded CMS form, optionally
 * alongside an image. The form is created in the admin and referenced by its
 * id/slug; if it doesn't exist yet the form area simply renders empty.
 */
interface Props {
	node: {
		eyebrow?: string;
		heading?: string;
		body?: string;
		formId: string;
		image?: string;
		imageAlt?: string;
		imagePosition?: "left" | "right";
		surface?: boolean;
	};
}

const FormEmbed = blockComponents["emdash-form"];
const { node } = Astro.props;
const pos = node.imagePosition ?? "right";
const hasImage = !!node.image;
---

<section class:list={["section", { "fs-surface": node.surface }]}>
	<div class="container">
		<div class:list={["fs-grid", { single: !hasImage, "fs-grid--rev": pos === "left" }]}>
			<div class="fs-content">
				{node.eyebrow && <span class="eyebrow">{node.eyebrow}</span>}
				{node.heading && <h2>{node.heading}</h2>}
				{node.body && <p class="fs-body">{node.body}</p>}
				<div class="fs-form">
					<FormEmbed node={{ formId: node.formId }} />
				</div>
			</div>

			{
				hasImage && (
					<div class="fs-media">
						<div class="fs-blob" aria-hidden="true" />
						<img src={node.image} alt={node.imageAlt || ""} loading="lazy" />
					</div>
				)
			}
		</div>
	</div>
</section>

<style>
	.fs-surface {
		background: var(--color-surface);
	}

	.fs-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: var(--spacing-4xl);
		align-items: center;
	}

	.fs-grid.single {
		grid-template-columns: minmax(0, 720px);
		justify-content: center;
	}

	.fs-grid--rev .fs-media {
		order: -1;
	}

	.fs-content {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.fs-body {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.fs-form {
		margin-top: var(--spacing-sm);
	}

	/* Estilo HEI: inputs pill + botón verde */
	.fs-form :global(.ec-form) {
		--ec-form-field-border: none;
		--ec-form-field-radius: 999px;
		--ec-form-field-padding: 0.75rem 1.25rem;
		--ec-form-field-bg: #f3f4f6;
		--ec-form-submit-bg: var(--color-primary);
		--ec-form-submit-color: #fff;
		--ec-form-submit-radius: 999px;
		--ec-form-submit-padding: 0.875rem 2rem;
	}
	.fs-form :global(.ec-form-input),
	.fs-form :global(.ec-form select),
	.fs-form :global(.ec-form textarea) {
		border: 1.5px solid #d1d5db;
		outline: none;
		box-shadow: none;
	}
	.fs-form :global(.ec-form textarea) {
		border-radius: var(--radius-lg);
	}
	.fs-form :global(.ec-form-input:focus),
	.fs-form :global(.ec-form select:focus),
	.fs-form :global(.ec-form textarea:focus) {
		outline: none;
		border-color: var(--color-primary);
	}
	.fs-form :global(.ec-form-submit) {
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-size: 0.875rem;
	}
	.fs-form :global(.ec-form-label) {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-text);
	}

	/* Grid 2 columnas para todos los campos */
	.fs-form :global(.ec-form-page) {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-md);
	}
	.fs-form :global(.ec-form-field) {
		width: 100%;
	}
	/* Botón del file input en español */
	.fs-form :global(input[type="file"]::file-selector-button) {
		content: "Seleccionar Archivo";
	}
	.fs-form :global(input[type="file"]) {
		padding: 0.5rem 1rem;
		background: #f3f4f6;
		border-radius: 999px;
		font-size: 0;
		cursor: pointer;
	}
	.fs-form :global(input[type="file"]::file-selector-button) {
		background: var(--color-primary);
		color: #fff;
		border: none;
		border-radius: 999px;
		padding: 0.35rem 1rem;
		margin-right: 0.75rem;
		font-weight: 600;
		font-size: 0.8rem;
		cursor: pointer;
	}

	/* Solo textarea ocupa ancho completo */
	.fs-form :global(.ec-form-field:has(textarea)) {
		grid-column: 1 / -1;
	}

	@media (max-width: 640px) {
		.fs-form :global(.ec-form-page) {
			grid-template-columns: 1fr;
		}
	}

	.fs-media {
		position: relative;
	}

	.fs-media img {
		width: 100%;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		position: relative;
		z-index: 1;
	}

	.fs-blob {
		position: absolute;
		width: 60%;
		height: 60%;
		left: -6%;
		bottom: -8%;
		background: var(--color-primary);
		opacity: 0.18;
		border-radius: 48% 52% 56% 44% / 52% 48% 52% 48%;
	}

	@media (max-width: 860px) {
		.fs-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-2xl);
		}
		.fs-grid--rev .fs-media {
			order: 0;
		}
	}
</style>
