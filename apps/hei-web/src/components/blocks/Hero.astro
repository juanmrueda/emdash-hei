---
interface Props {
	node: {
		eyebrow?: string;
		headline: string;
		highlight?: string;
		subheadline?: string;
		image?: string;
		imageAlt?: string;
		variant?: "image" | "solid";
		overlay?: boolean;
		full?: boolean;
		focal?: string;
		primaryCtaLabel?: string;
		primaryCtaUrl?: string;
		secondaryCtaLabel?: string;
		secondaryCtaUrl?: string;
	};
}

const { node } = Astro.props;
const variant = node.variant ?? "image";
const isFullHero = variant === "image" && node.full;
const isImageHero = variant === "image";
const hasPrimary = node.primaryCtaLabel && node.primaryCtaUrl;
const hasSecondary = node.secondaryCtaLabel && node.secondaryCtaUrl;
const bgStyle = node.image
	? `background-image:url('${node.image}');${node.focal ? `background-position:${node.focal};` : ""}`
	: undefined;

let parts: { text: string; hl: boolean }[] = [{ text: node.headline, hl: false }];
if (node.highlight && node.headline.includes(node.highlight)) {
	const [before, ...rest] = node.headline.split(node.highlight);
	parts = [
		{ text: before, hl: false },
		{ text: node.highlight, hl: true },
		{ text: rest.join(node.highlight), hl: false },
	];
}
---

{
	isImageHero ? (
		<section class={isFullHero ? "hero" : "page-hero"} style={bgStyle}>
			<div class={isFullHero ? "hero__overlay" : "page-hero__overlay"}></div>
			<div class={isFullHero ? "hero__content" : "page-hero__content"}>
				<h1>{parts.map((p) => (p.hl ? <span>{p.text}</span> : p.text))}</h1>
				{node.subheadline && <p>{node.subheadline}</p>}
				{(hasPrimary || hasSecondary) && (
					<div class="hero__btns">
						{hasPrimary && (
							<a href={node.primaryCtaUrl} class="btn btn-primary">
								{node.primaryCtaLabel}
								<span class="btn__icon" aria-hidden="true">
									<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M3 9H15M15 9L9 3M15 9L9 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</span>
							</a>
						)}
						{hasSecondary && (
							<a href={node.secondaryCtaUrl} class={isFullHero ? "btn btn-outline-white-b" : "btn btn-outline-white"}>
								{node.secondaryCtaLabel}
							</a>
						)}
					</div>
				)}
			</div>
		</section>
	) : (
		<section class="salutia-heroint">
			<div>
				<div class="salutia-hero__body">
					<h1>{parts.map((p) => (p.hl ? <span>{p.text}</span> : p.text))}</h1>
					{node.subheadline && <p>{node.subheadline}</p>}
					{(hasPrimary || hasSecondary) && (
						<div class="split__btns">
							{hasPrimary && (
								<a href={node.primaryCtaUrl} class="btn btn-white">
									{node.primaryCtaLabel}
								</a>
							)}
							{hasSecondary && (
								<a href={node.secondaryCtaUrl} class="btn btn-outline-white">
									{node.secondaryCtaLabel}
								</a>
							)}
						</div>
					)}
				</div>
				{node.image && <div class="salutia-hero__img" style={bgStyle}></div>}
			</div>
		</section>
	)
}
