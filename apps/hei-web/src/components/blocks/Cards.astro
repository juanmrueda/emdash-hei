---
import Icon from "../Icon.astro";

/**
 * Card grid. Modo normal (cols-N) para grids uniformes (Tres ejes, features),
 * y modo "bento" para layouts asimétricos (Pilares): cada tarjeta puede tener
 * span ancho/angosto, imagen de fondo y una decoración de semicírculo.
 */
interface CardItem {
	icon?: string;
	title?: string;
	titleColor?: "green";
	text?: string;
	bullets?: string[];
	color?: "white" | "blue" | "green" | "navy";
	span?: "wide" | "narrow";
	image?: string;
	imageTop?: boolean;
	imageOnly?: boolean;
	rowSpan?: boolean;
	decoration?: boolean;
}
interface Props {
	node: {
		eyebrow?: string;
		heading?: string;
		headingColor?: "green";
		subheading?: string;
		columns?: 2 | 3 | 4;
		align?: "left" | "center";
		bento?: boolean;
		items: CardItem[];
		surface?: boolean;
	};
}

const ICONS: Record<string, string> = {
	health: "heartbeat",
	transparency: "thumbs-up",
	future: "hourglass",
	integration: "stack",
	trust: "shield-check",
	capacity: "lightning",
	growth: "plant",
	logistics: "truck",
	network: "users",
	software: "gear",
	shield: "shield",
	leaf: "leaf",
	check: "check-circle",
	heart: "hand-heart",
	bulb: "bulb",
	handshake: "handshake",
	gauge: "gauge",
};

const { node } = Astro.props;
const cols = node.columns ?? 3;
const align = node.align ?? "center";
const bento = !!node.bento;
const items = node.items ?? [];

const toList = (v: unknown): string[] =>
	Array.isArray(v)
		? (v as string[])
		: typeof v === "string"
			? v.split("\n").map((s) => s.trim()).filter(Boolean)
			: [];
---

<section class:list={["section cards-section", { "cards-surface": node.surface, "cards-compact": items.length === 0 }]}>
	<div class="container">
		{
			(node.eyebrow || node.heading) && (
				<div class:list={["section-heading", { "sh-left": align === "left" }]}>
					{node.eyebrow && <span class="eyebrow">{node.eyebrow}</span>}
					{node.heading && (
						<h2 class:list={{ "h-green": node.headingColor === "green" }}>{node.heading}</h2>
					)}
					<div class="heading-rule" />
					{node.subheading && <p>{node.subheading}</p>}
				</div>
			)
		}

		<div class:list={["cards-grid", bento ? "bento" : `cols-${cols}`, `align-${align}`]}>
			{
				items.map((c) => (
					<article
						class:list={[
							"card",
							`card--${c.color || "white"}`,
							bento && c.span === "wide" && "span-wide",
							bento && c.span === "narrow" && "span-narrow",
							c.image && !c.imageTop && "has-img",
							c.image && c.imageTop && "has-img-top",
							c.image && c.imageTop && c.imageOnly && "img-only",
							c.rowSpan && "row-span",
							c.decoration && "has-deco",
						]}
					>
						{c.image && !c.imageTop && <img class="card-bg" src={c.image} alt="" loading="lazy" />}
						{c.image && c.imageTop && <img class="card-img-top" src={c.image} alt="" loading="lazy" />}
						{!c.imageOnly && c.decoration && <span class="card-deco" aria-hidden="true" />}
						{!c.imageOnly && c.icon && (
							<span class="card-icon">
								<Icon name={ICONS[c.icon] || "check-circle"} size={28} />
							</span>
						)}
						{!c.imageOnly && (
							<div class="card-body">
								{c.title && (
									<h3 class:list={["card-title", c.titleColor === "green" && "title-green"]}>
										{c.title}
									</h3>
								)}
								{c.text && <p class="card-text">{c.text}</p>}
								{toList(c.bullets).length > 0 && (
									<ul class="card-bullets">
										{toList(c.bullets).map((b) => (
											<li>
												<Icon name="check" />
												<span>{b}</span>
											</li>
										))}
									</ul>
								)}
							</div>
						)}
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.cards-surface {
		background: var(--color-surface);
	}

	/* Sección solo-heading (sin cards): padding reducido */
	.cards-compact {
		padding-top: var(--spacing-sm);
		padding-bottom: var(--spacing-sm);
	}

	/* Heading alineado a la izquierda. */
	.section-heading.sh-left {
		text-align: start;
		max-width: 640px;
		margin-inline: 0;
	}
	.section-heading.sh-left .heading-rule {
		margin-inline: 0;
	}
	.h-green {
		color: var(--color-primary);
	}

	.cards-grid {
		display: grid;
		gap: var(--spacing-lg);
	}

	.cols-2 {
		grid-template-columns: repeat(2, 1fr);
	}
	.cols-3 {
		grid-template-columns: repeat(3, 1fr);
	}
	.cols-4 {
		grid-template-columns: repeat(4, 1fr);
	}

	/* Bento: 3 columnas; wide ocupa 2, narrow 1. Filas según contenido. */
	.cards-grid.bento {
		grid-template-columns: repeat(3, 1fr);
		grid-auto-rows: auto;
	}
	.bento .span-wide {
		grid-column: span 2;
	}
	.bento .span-narrow {
		grid-column: span 1;
	}

	.align-center .card {
		text-align: center;
		align-items: center;
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		padding: var(--spacing-2xl);
		border-radius: var(--radius-lg);
		background: #fff;
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
	}

	/* Bento: ícono arriba, contenido abajo; altura moderada. */
	.bento .card {
		min-height: 210px;
		padding: var(--spacing-xl);
		justify-content: space-between;
		gap: var(--spacing-xl);
	}
	.bento .card-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.card--blue {
		background: var(--color-accent);
		border-color: transparent;
		color: #fff;
	}
	.card--green {
		background: var(--color-primary);
		border-color: transparent;
		color: #fff;
	}
	.card--navy {
		background: var(--color-navy);
		border-color: transparent;
		color: #fff;
	}

	/* Tarjeta con imagen arriba y texto abajo. */
	.card.has-img-top {
		padding: 0;
		overflow: hidden;
	}
	.card-img-top {
		width: 100%;
		height: 220px;
		object-fit: cover;
		object-position: center top;
		display: block;
		flex-shrink: 0;
	}
	.card.has-img-top > .card-icon,
	.card.has-img-top > .card-body {
		padding: var(--spacing-lg);
	}
	.card.has-img-top > .card-icon {
		padding-bottom: 0;
	}

	/* Tarjeta solo-foto: la imagen llena toda la altura. */
	.card.img-only {
		padding: 0;
	}
	.card.img-only .card-img-top {
		height: 100%;
		object-position: center top;
	}

	/* Tarjeta que ocupa 2 filas del grid. */
	.row-span {
		grid-row: span 2;
	}

	.title-green {
		color: var(--color-primary) !important;
	}

	/* Tarjeta con imagen de fondo + filtro verde (Crecimiento). */
	.card-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}
	.card.has-img::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(120deg, rgba(49, 214, 151, 0.8), rgba(32, 189, 130, 0.84));
	}
	/* El contenido va sobre el filtro, pero NO la imagen de fondo. */
	.card.has-img > *:not(.card-bg) {
		position: relative;
		z-index: 2;
	}

	/* Decoración: semicírculo verde claro arriba-derecha (Integración). */
	.card-deco {
		position: absolute;
		top: 0;
		right: 0;
		width: 150px;
		height: 150px;
		background: var(--color-primary-50);
		border-bottom-left-radius: 100%;
		z-index: 0;
	}
	.has-deco > *:not(.card-deco) {
		position: relative;
		z-index: 1;
	}

	.card-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		border-radius: var(--radius-full);
		background: var(--color-primary-50);
		color: var(--color-primary);
	}

	.align-center .card-icon {
		color: var(--color-accent);
		background: #eaf0fe;
	}

	.card--blue .card-icon,
	.card--green .card-icon,
	.card--navy .card-icon {
		background: rgba(255, 255, 255, 0.18);
		color: #fff;
	}

	/* Bento: tarjeta blanca → círculo verde sólido; coloreadas → contorno. */
	.bento .card--white .card-icon {
		background: var(--color-primary);
		color: #fff;
	}
	.bento .card--blue .card-icon,
	.bento .card--green .card-icon {
		background: transparent;
		border: 2px solid rgba(255, 255, 255, 0.65);
		color: #fff;
	}

	.card-title {
		font-size: var(--font-size-xl);
	}

	.align-center .card-title {
		color: var(--color-accent);
	}

	.card--blue .card-title,
	.card--green .card-title,
	.card--navy .card-title {
		color: #fff;
	}

	.card-text {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		line-height: 1.6;
	}

	.card--blue .card-text,
	.card--green .card-text,
	.card--navy .card-text {
		color: rgba(255, 255, 255, 0.9);
	}

	.card-bullets {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
		text-align: start;
		width: 100%;
	}

	.card-bullets li {
		display: flex;
		gap: var(--spacing-sm);
		font-size: var(--font-size-sm);
		color: var(--color-text);
	}

	.card-bullets :global(svg) {
		color: var(--color-primary);
		flex-shrink: 0;
		margin-top: 3px;
	}

	@media (max-width: 900px) {
		.cols-3,
		.cols-4 {
			grid-template-columns: repeat(2, 1fr);
		}
		/* Bento → apila en una columna en pantallas medianas/chicas. */
		.cards-grid.bento {
			grid-template-columns: 1fr;
			grid-auto-rows: auto;
		}
		.bento .span-wide,
		.bento .span-narrow {
			grid-column: span 1;
		}
		.bento .card {
			min-height: 200px;
		}
	}

	@media (max-width: 600px) {
		.cols-2,
		.cols-3,
		.cols-4 {
			grid-template-columns: 1fr;
		}
	}
</style>
