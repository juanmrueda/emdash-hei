---
import { mediaUrl } from "../../lib/media";

interface CardItem {
	icon?: string;
	iconUrl?: string;
	title?: string;
	subtitle?: string;
	titleColor?: "green";
	text?: string;
	bullets?: string[] | string;
	category?: string[] | string;
	categories?: string[] | string;
	applyUrl?: string;
	applyLabel?: string;
	color?: string;
	span?: "wide" | "narrow";
	image?: unknown;
	gradientColor?: string;
	imageTop?: boolean;
	imageOnly?: boolean;
	rowSpan?: boolean;
	decoration?: boolean;
}

interface Props {
	node: {
		_key?: string;
		id?: string;
		eyebrow?: string;
		heading?: string;
		headingColor?: "green";
		subheading?: string;
		layout?: "service" | "default";
		columns?: 2 | 3 | 4;
		align?: "left" | "center";
		bento?: boolean;
		items: CardItem[];
		surface?: boolean;
	};
}

const iconSrc = (card: CardItem) =>
	card.iconUrl || mediaUrl(card.icon) || (card.icon ? ICONS[card.icon] : undefined);

const bgStyle = (card: CardItem) => {
	const img = mediaUrl(card.image);
	if (!img) return undefined;
	// If gradientColor is set, layer it on top of the bg image
	const gradient = card.gradientColor
		? `linear-gradient(${card.gradientColor}, ${card.gradientColor})`
		: "";
	return gradient
		? `background-image:${gradient},url('${img}');`
		: `background-image:url('${img}');`;
};

const { node } = Astro.props;
const items = node.items ?? [];
const key = node._key ?? "";

const ICONS: Record<string, string> = {
	health: "/wp/iconos/salud.png",
	transparency: "/wp/iconos/transparencia.png",
	future: "/wp/iconos/futuro.png",
	logistics: "/wp/iconos/ico-logistica.png",
	network: "/wp/iconos/ico-servicio.png",
	software: "/wp/iconos/ico-software.png",
	shield: "/wp/iconos/transparencia.png",
	growth: "/wp/iconos/futuro.png",
	gauge: "/wp/iconos/ico-software.png",
};

const isDarkColor = (color?: string): boolean => {
	if (!color) return false;
	const c = color.toLowerCase();
	if (["blue", "navy", "green", "dark", "black"].includes(c)) return true;
	if (c.startsWith("#")) {
		const h = c.replace("#", "");
		if (h.length < 6) return false;
		const r = parseInt(h.substring(0, 2), 16);
		const g = parseInt(h.substring(2, 4), 16);
		const b = parseInt(h.substring(4, 6), 16);
		if (isNaN(r) || isNaN(g) || isNaN(b)) return false;
		return (r * 299 + g * 587 + b * 114) / 1000 < 128;
	}
	return false;
};

const toList = (value: unknown): string[] =>
	Array.isArray(value)
		? (value as string[])
		: typeof value === "string"
			? value.split("\n").map((s) => s.trim()).filter(Boolean)
			: [];

const isPilares = key === "q-pilares" || node.bento;
const isCulture = key === "t-cultura";
const isJobs = key === "t-oportunidades";
const isIntroOnly = items.length === 0;
const isServiceGrid = node.layout === "service" || key.startsWith("s-") || key.startsWith("cendi-") || key.startsWith("meliora-");

const slugify = (value: string): string =>
	value
		.normalize("NFD")
		.replace(/[\u0300-\u036f]/g, "")
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-+|-+$/g, "");

const categoryLabels = (value: unknown): string[] => {
	if (Array.isArray(value)) return value.flatMap(categoryLabels);
	if (typeof value !== "string") return [];
	return value
		.split(/[,\n|]+/)
		.map((label) => label.trim())
		.filter(Boolean);
};

const getJobCategories = (job: CardItem) =>
	categoryLabels(job.categories ?? job.category)
		.map((label) => ({ label, slug: slugify(label) }))
		.filter((category) => category.slug);

const jobCategories = (() => {
	const bySlug = new Map<string, { label: string; slug: string }>();
	for (const job of items) {
		for (const category of getJobCategories(job)) {
			if (!bySlug.has(category.slug)) bySlug.set(category.slug, category);
		}
	}
	return [...bySlug.values()];
})();

const jobListId = `${key || "jobs"}-cards`;
---

{
	isPilares ? (
		<section class="section">
			<div class="container">
				{node.heading && <h2 class="text-green">{node.heading}</h2>}
				{node.subheading && <p class="mt-16 mw-610">{node.subheading}</p>}
				<div class="pilares-grid">
					{items.map((card) => {
						const bg = bgStyle(card);
						const bgColor = !bg && card.color ? card.color : undefined;
						const dark = isDarkColor(bg ? undefined : card.color);
						const classes = ["pilar-card"];
						if (bg) classes.push("pilar-card--img");
						if (!bg && dark) classes.push("pilar-card--dark");
						if (card.decoration) classes.push("pilar-card--decorated");
						return (
							<div class={classes.join(" ")} style={bg || (bgColor ? `background-color:${bgColor};` : undefined)}>
								{iconSrc(card) && <div class="pilar-card__icon"><img src={iconSrc(card)} alt="" loading="lazy" /></div>}
								{card.title && <h3>{card.title}</h3>}
								{card.text && <p>{card.text}</p>}
							</div>
						);
					})}
				</div>
			</div>
		</section>
	) : isCulture ? (
		<>
			<section class="intro-section">
				<div class="container">
					{node.heading && <h2>{node.heading}</h2>}
					<div class="section-header__line" style="margin:12px auto 20px;"></div>
					{node.subheading && <p>{node.subheading}</p>}
				</div>
			</section>
			<section class="splithome bg-white">
				<div class="col-1-1">
					{items[0]?.image && <div class="split__img" style={`border-radius:28px;background-image:url('${items[0].image}');`}></div>}
					<div class="split__body split__body--white">
						{items.slice(1).map((card, index) => (
							<>
								{card.title && <h2 class:list={["text-green", { "mt-24": index > 0 }]}>{card.title}</h2>}
								{card.text && <p>{card.text}</p>}
								{toList(card.bullets).length > 0 && (
									<ul class="bullet-list mt-16">
										{toList(card.bullets).map((bullet) => (
											<li>
												<span class="bullet-icon" aria-hidden="true">
													<svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
														<path d="M5 13L9 17L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
													</svg>
												</span>
												<span>{bullet}</span>
											</li>
										))}
									</ul>
								)}
							</>
						))}
					</div>
				</div>
			</section>
		</>
	) : isJobs ? (
		<section class="section bg-white">
			<div class="container">
				<div class="section-header">
					{node.heading && <h2>{node.heading}</h2>}
					<div class="section-header__line"></div>
					{node.subheading && <p>{node.subheading}</p>}
				</div>
				{jobCategories.length > 0 && (
					<div class="tabs tabscenter" data-hei-job-tabs data-target={jobListId}>
						<button class="tab-btn active" type="button" data-cat="all" aria-pressed="true">Todos</button>
						{jobCategories.map((category) => (
							<button class="tab-btn" type="button" data-cat={category.slug} aria-pressed="false">
								{category.label}
							</button>
						))}
					</div>
				)}
				<div class="job-cards" id={jobListId}>
					{items.map((job) => {
						const categories = getJobCategories(job);
						const categorySlugs = categories.map((category) => category.slug).join(" ");
						const jobIcon = iconSrc(job);

						return (
							<div class="job-card" data-cats={categorySlugs || "all"}>
								<div class="job-card__badge">
									{jobIcon && <img src={jobIcon} alt="" loading="lazy" />}
								</div>
								{job.title && <h3 class="job-card__title">{job.title}</h3>}
								{job.subtitle && <p class="job-card__subtitle">{job.subtitle}</p>}
								{job.text && <p class="job-card__desc">{job.text}</p>}
								{job.applyUrl ? (
									<a href={job.applyUrl} class="btn btn-primary mt-24">
										{job.applyLabel || "Quiero aplicar"}
									</a>
								) : (
									<button class="btn btn-primary mt-24" disabled>Quiero aplicar</button>
								)}
							</div>
						);
					})}
				</div>
			</div>
			<script is:inline>
				(() => {
					document.querySelectorAll("[data-hei-job-tabs]").forEach((tabsContainer) => {
						const targetId = tabsContainer.getAttribute("data-target");
						const cardsContainer = targetId ? document.getElementById(targetId) : null;
						if (!cardsContainer) return;

						tabsContainer.addEventListener("click", (event) => {
							const button = event.target.closest(".tab-btn");
							if (!button) return;

							tabsContainer.querySelectorAll(".tab-btn").forEach((tab) => {
								tab.classList.remove("active");
								tab.setAttribute("aria-pressed", "false");
							});
							button.classList.add("active");
							button.setAttribute("aria-pressed", "true");

							const activeCategory = button.getAttribute("data-cat");
							cardsContainer.querySelectorAll(".job-card").forEach((card) => {
								const categories = (card.getAttribute("data-cats") || "").split(/\s+/);
								const visible = activeCategory === "all" || categories.includes(activeCategory);
								card.style.display = visible ? "" : "none";
							});
						});
					});
				})();
			</script>
		</section>
	) : isIntroOnly ? (
		<section class="intro-section top0">
			<div class="container">
				{node.heading && <h2>{node.heading}</h2>}
				<div class="section-header__line" style="margin:12px auto 20px;"></div>
				{node.subheading && <p>{node.subheading}</p>}
			</div>
		</section>
	) : isServiceGrid ? (
		<>
			<section class="intro-section">
				<div class="container">
					{node.heading && <h2>{node.heading}</h2>}
					<div class="section-header__line" style="margin:12px auto 20px;"></div>
					{node.subheading && <p>{node.subheading}</p>}
				</div>
			</section>
			<section class="section bg-white home" id={node.id || "servicios"}>
				<div class="container">
					<div class="cards-grid">
						{items.map((card) => {
							const img = iconSrc(card);
							return (
								<div class="service-card">
									<div class="service-card__icon-wrap">
										{img && <img src={img} alt={card.title || ""} loading="lazy" />}
									</div>
									{card.title && <h3>{card.title}</h3>}
									{card.text && <p>{card.text}</p>}
								</div>
							);
						})}
					</div>
				</div>
			</section>
		</>
	) : (
		<section class="section bg-white home" id={node.id}>
			<div class="container">
				{node.heading && (
					<div class="section-header">
						<h2>{node.heading}</h2>
						<div class="section-header__line"></div>
						{node.subheading && <p>{node.subheading}</p>}
					</div>
				)}
				<div class="cards-grid">
					{items.map((card) => {
						const img = iconSrc(card);
						return (
							<div class="card">
								{img && <img src={img} alt={card.title || ""} class="card__icon" loading="lazy" />}
								{card.title && <h3 class="card__title" style="color:var(--blue);">{card.title}</h3>}
								{card.subtitle && <p class="card__body" style="font-weight:600;margin-bottom:8px;">{card.subtitle}</p>}
								{card.text && <p class="card__body">{card.text}</p>}
							</div>
						);
					})}
				</div>
			</div>
		</section>
	)
}
