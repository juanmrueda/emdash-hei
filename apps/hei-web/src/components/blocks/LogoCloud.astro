---
interface LogoItem {
	name: string;
	logo?: string;
	url?: string;
}

interface Props {
	node: {
		eyebrow?: string;
		items: LogoItem[];
	};
}

const { node } = Astro.props;
const items = node.items ?? [];
---

<section class="marcas-strip">
	<div class="container">
		{node.eyebrow && <p class="marcas-strip__title">{node.eyebrow}</p>}
		<div class="marcas-strip__logos">
			{
				items.map((item) => {
					const image = item.logo && <img src={item.logo} alt={item.name} loading="lazy" />;
					return item.url ? <a href={item.url}>{image}</a> : <span>{image}</span>;
				})
			}
		</div>
	</div>
</section>
