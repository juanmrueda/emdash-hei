---
/**
 * Row of brand logos with an eyebrow caption (Home "una base estratégica").
 * Renders styled wordmarks until real logo images are supplied.
 */
interface LogoItem {
	name: string;
	logo?: string;
	url?: string;
}
interface Props {
	node: {
		eyebrow?: string;
		items: LogoItem[];
	};
}

const { node } = Astro.props;
const items = node.items ?? [];
---

<section class="section logocloud">
	<div class="container">
		{node.eyebrow && <p class="logocloud-eyebrow">{node.eyebrow}</p>}
		<div class="logocloud-row">
			{
				items.map((b) => {
					const inner = b.logo ? (
						<img src={b.logo} alt={b.name} loading="lazy" />
					) : (
						<span class="logocloud-word">{b.name}</span>
					);
					return b.url ? (
						<a href={b.url} class="logocloud-item">
							{inner}
						</a>
					) : (
						<span class="logocloud-item">{inner}</span>
					);
				})
			}
		</div>
	</div>
</section>

<style>
	.logocloud {
		text-align: center;
	}

	.logocloud-eyebrow {
		font-size: var(--font-size-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-bottom: var(--spacing-xl);
	}

	.logocloud-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-3xl);
	}

	.logocloud-item img {
		max-height: 40px;
		width: auto;
		opacity: 0.8;
		transition: opacity var(--transition-fast);
	}

	.logocloud-item:hover img {
		opacity: 1;
	}

	.logocloud-word {
		font-size: var(--font-size-2xl);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--color-navy);
		opacity: 0.75;
	}
</style>
