---
import Icon from "../Icon.astro";

/**
 * Brand portfolio rows (Marcas page). Each row shows the brand logo on one
 * side and a descriptive block on the other. Falls back to a styled wordmark
 * when no logo image is supplied yet.
 */
interface BrandItem {
	name: string;
	logo?: string;
	eyebrow?: string;
	heading: string;
	bullets?: string[];
	ctaLabel?: string;
	ctaUrl?: string;
}
interface Props {
	node: {
		eyebrow?: string;
		heading?: string;
		subheading?: string;
		items: BrandItem[];
	};
}

const { node } = Astro.props;
const items = node.items ?? [];

// Bullets may arrive as an array (seed) or newline string (editor).
const toList = (v: unknown): string[] =>
	Array.isArray(v)
		? (v as string[])
		: typeof v === "string"
			? v.split("\n").map((s) => s.trim()).filter(Boolean)
			: [];
---

<section class="section">
	<div class="container">
		{
			(node.eyebrow || node.heading) && (
				<div class="section-heading">
					{node.eyebrow && <span class="eyebrow">{node.eyebrow}</span>}
					{node.heading && <h2>{node.heading}</h2>}
					<div class="heading-rule" />
					{node.subheading && <p>{node.subheading}</p>}
				</div>
			)
		}

		<div class="brand-rows">
			{
				items.map((b, i) => (
					<article class:list={["brand-row", { rev: i % 2 === 1 }]}>
						<div class="brand-logo">
							{b.logo ? (
								<img src={b.logo} alt={b.name} loading="lazy" />
							) : (
								<span class="brand-wordmark">{b.name}</span>
							)}
						</div>
						<div class="brand-info">
							{b.eyebrow && <span class="eyebrow">{b.eyebrow}</span>}
							<h3>{b.heading}</h3>
							{toList(b.bullets).length > 0 && (
								<ul class="brand-bullets">
									{toList(b.bullets).map((x) => (
										<li>
											<Icon name="check-circle" />
											<span>{x}</span>
										</li>
									))}
								</ul>
							)}
							{b.ctaLabel && b.ctaUrl && (
								<a href={b.ctaUrl} class="btn btn-primary">
									{b.ctaLabel}
								</a>
							)}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.brand-rows {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2xl);
	}

	.brand-row {
		display: grid;
		grid-template-columns: 1fr 1.3fr;
		gap: var(--spacing-3xl);
		align-items: center;
		padding: var(--spacing-2xl) 0;
		border-top: 1px solid var(--color-border);
	}

	.brand-row:first-child {
		border-top: none;
	}

	.brand-row.rev .brand-logo {
		order: 2;
	}

	.brand-logo {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 120px;
	}

	.brand-logo img {
		max-height: 80px;
		width: auto;
	}

	.brand-wordmark {
		font-size: var(--font-size-4xl);
		font-weight: 800;
		letter-spacing: -0.04em;
		color: var(--color-navy);
	}

	.brand-info {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.brand-info h3 {
		color: var(--color-primary);
		font-size: var(--font-size-2xl);
	}

	.brand-bullets {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.brand-bullets li {
		display: flex;
		gap: var(--spacing-sm);
		color: var(--color-text);
		font-size: var(--font-size-sm);
	}

	.brand-bullets :global(svg) {
		color: var(--color-primary);
		flex-shrink: 0;
		margin-top: 2px;
	}

	.brand-info .btn {
		align-self: flex-start;
		margin-top: var(--spacing-xs);
	}

	@media (max-width: 768px) {
		.brand-row {
			grid-template-columns: 1fr;
			gap: var(--spacing-lg);
			text-align: center;
		}
		.brand-row.rev .brand-logo {
			order: 0;
		}
		.brand-info {
			align-items: center;
		}
		.brand-bullets {
			text-align: start;
		}
	}
</style>
