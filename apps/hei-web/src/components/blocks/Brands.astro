---
interface BrandItem {
	name: string;
	logo?: string;
	eyebrow?: string;
	heading: string;
	text?: string;
	bullets?: string[] | string;
	ctaLabel?: string;
	ctaUrl?: string;
}

interface Props {
	node: {
		eyebrow?: string;
		heading?: string;
		subheading?: string;
		items: BrandItem[];
	};
}

const { node } = Astro.props;
const items = node.items ?? [];
const toList = (value: unknown): string[] =>
	Array.isArray(value)
		? (value as string[])
		: typeof value === "string"
			? value.split("\n").map((s) => s.trim()).filter(Boolean)
			: [];

const defaultText: Record<string, string> = {
	cendis:
		"CENDIS distribuye y comercializa productos medicos y farmaceuticos en Guatemala. Su trayectoria, cobertura y portafolio la convierten en la base operativa del ecosistema.",
	meliora:
		"Meliora forma parte de Grupo HEI y representa una linea de crecimiento dentro del ecosistema de salud.",
	Salutia:
		"Salutia apoya a laboratorios y farmaceuticas que necesitan operar con mayor control sin montar toda la infraestructura propia.",
	salutia:
		"Salutia apoya a laboratorios y farmaceuticas que necesitan operar con mayor control sin montar toda la infraestructura propia.",
};
---

{
	(node.heading || node.subheading) && (
		<section class="intro-section" style="background:var(--bg);">
			<div class="container">
				{node.heading && <h2>{node.heading}</h2>}
				<div class="section-header__line" style="margin:12px auto 20px;"></div>
				{node.subheading && <p>{node.subheading}</p>}
			</div>
		</section>
	)
}

{
	items.map((brand, index) => (
		<section class="marca-section" style={index % 2 ? "background:var(--bg);" : undefined}>
			<div class="marca-logo-box">
				{brand.logo && <img src={brand.logo} alt={brand.name} loading="lazy" />}
			</div>
			<div class="marca-content">
				<h2>{brand.heading}</h2>
				<p>{brand.text || brand.eyebrow || defaultText[brand.name] || ""}</p>
				{toList(brand.bullets).length > 0 && (
					<ul class="bullet-list">
						{toList(brand.bullets).map((bullet) => (
							<li>
								<span class="bullet-icon" aria-hidden="true">
									<svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M5 13L9 17L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</span>
								<span>{bullet}</span>
							</li>
						))}
					</ul>
				)}
				{brand.ctaLabel && brand.ctaUrl && (
					<a href={brand.ctaUrl} class="btn btn-primary mt-24">
						{brand.ctaLabel}
					</a>
				)}
			</div>
		</section>
	))
}
