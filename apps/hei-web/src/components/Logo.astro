---
/**
 * Grupo HEI wordmark (logo oficial exportado de Figma).
 * `variant="light"` usa la versión en blanco para fondos oscuros/foto.
 */
interface Props {
	variant?: "dark" | "light";
}
const { variant = "dark" } = Astro.props;
const src = variant === "light" ? "/logos/hei-white.png" : "/logos/hei.png";
---

<img class="hei-logo" src={src} alt="Grupo HEI" width="120" height="76" />

<style>
	.hei-logo {
		height: 44px;
		width: auto;
		display: block;
	}
</style>
